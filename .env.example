# Copy to .env.local and fill in. Both are server-only: never prefix with NEXT_PUBLIC_.
# Without them the app still runs, but /api/builds returns 503 {"error":"backend_not_configured"}.

# Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Project Settings > API > service_role key (secret, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
